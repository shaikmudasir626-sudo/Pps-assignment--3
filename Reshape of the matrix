#include <stdlib.h>

/**
 * Return an array of arrays of size *returnSize.
 * The sizes of the arrays are returned as *returnColumnSizes array.
 * Note: Both returned array and *columnSizes array must be malloced, assume caller calls free().
 */
int** matrixReshape(int** mat, int matSize, int* matColSize, int r, int c, int* returnSize, int** returnColumnSizes) {
    int m = matSize;
    int n = matColSize[0];

    // If reshape is not possible, return a copy of the original matrix
    if (m * n != r * c) {
        *returnSize = m;
        *returnColumnSizes = (int*)malloc(m * sizeof(int));
        int** copy = (int**)malloc(m * sizeof(int*));
        
        for (int i = 0; i < m; i++) {
            (*returnColumnSizes)[i] = n;
            copy[i] = (int*)malloc(n * sizeof(int));
            for (int j = 0; j < n; j++) {
                copy[i][j] = mat[i][j];
            }
        }
        return copy;
    }

    // Allocate memory for the r x c reshaped matrix
    *returnSize = r;
    *returnColumnSizes = (int*)malloc(r * sizeof(int));
    int** result = (int**)malloc(r * sizeof(int*));

    for (int i = 0; i < r; i++) {
        (*returnColumnSizes)[i] = c;
        result[i] = (int*)malloc(c * sizeof(int));
    }

    // Map 1D linear index directly to 2D coordinates in both matrices
    for (int i = 0; i < m * n; i++) {
        result[i / c][i % c] = mat[i / n][i % n];
    }

    return result;
}

